      "uiPath": "/find-research-and-innovation/project/9c2540e5-e001-4808-be81-1a927e2e06de",
      "projectTitle": "Digital clinical pathway for upper limb prosthetics and rehabilitation",
      "projectStatus": "Closed",
      "grantRefNumber": "81412",
      "grantCategory": "Collaborative R&D",
      "totalGrantValue": 174717.6,
      "startDate": "2020-10-01T00:00:00Z",
