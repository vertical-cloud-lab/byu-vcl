      "projectTitle": "Novel Partial Hand Prosthesis for people with disability",
      "projectStatus": "Closed",
      "grantRefNumber": "10049773",
      "grantCategory": "Grant for R&D",
      "totalGrantValue": 50000,
      "startDate": "2023-04-01T00:00:00Z",
      "endDate": "2024-03-31T00:00:00Z",
      "fundingOrgName": "Innovate UK",
      "fundingOrgLongName": "INNOVATE UK",
