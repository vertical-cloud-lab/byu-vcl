diff --git a/include/Stirrer.h b/include/Stirrer.h
new file mode 100644
index 0000000..4ec49f5
--- /dev/null
+++ b/include/Stirrer.h
@@ -0,0 +1,41 @@
+#ifndef STIRRER_H
+#define STIRRER_H
+
+#include <Arduino.h>
+
+// [VCL] Single-vial magnetic stirrer (byu-vcl hardware/vial-stirrer-cubxl):
+// a 2-wire 40 mm fan switched low-side by an N-MOSFET, two opposite-pole
+// magnets on its hub, and a US1881 Hall latch beside them that gives one
+// falling edge per turn. Closed-loop rpm, after the Pioreactor's stirring job.
+//
+// Pins: the only free hardware PWM pin and the free external interrupt.
+#define STIR_PWM_PIN 10        // OC1B -> 100 R -> MOSFET gate (10 k gate pull-down on the stirrer)
+#define STIR_HALL_PIN 2        // INT0 <- US1881 output (open drain, 10 k pull-up to 5 V on the stirrer)
+
+// Timer1 is otherwise unused by this firmware (EMAG is on pin 11, Timer2), so it
+// is set to phase-correct PWM with TOP = ICR1: 16 MHz / (2 * 64 * 625) = 200 Hz,
+// the Pioreactor's fan PWM frequency. D9 (pipette limit switch) shares Timer1
+// but stays a plain input: only OC1B is connected.
+#define STIR_PWM_TOP 625
+
+#define STIR_PULSES_PER_REV 1      // one latch toggle pair per turn
+#define STIR_MIN_EDGE_US 5000UL    // ignore edges closer than this (12,000 rpm): noise on the cable
+#define STIR_UPDATE_MS 2000UL      // control update period
+#define STIR_KP 0.0002f            // duty fraction per rpm of error, per update. Tune on the bench
+#define STIR_MAX_STEP 0.075f       // the Pioreactor clamps each update to 7.5 points of duty
+#define STIR_RAMP 100.0f           // setpoint ramp, rpm per second
+#define STIR_DC_START 0.30f        // Pioreactor initial_duty_cycle = 30
+#define STIR_RPM_MIN 100.0f        // Pioreactor: ~125 rpm practical floor
+#define STIR_RPM_MAX 2000.0f       // Pioreactor cap
+#define STIR_KICK_MS 500UL         // full power, to break the fan free
+#define STIR_PAUSE_MS 750UL        // off before a stall kick, as the Pioreactor does
+#define STIR_STALL_TRIES 5         // updates with no pulses before giving up
+#define STIR_STALL_DUTY_MAX 0.60f  // Pioreactor's "avoid the death spiral" cap
+
+void setupStirrer();
+void updateStirrer();                          // call from loop(); never blocks, never prints
+float setStirrer(float rpm, float seconds);    // rpm <= 0 stops; seconds <= 0 runs until stopped.
+                                               // Returns the target actually set (clamped)
+void sendStirrerStatusResponse();
+
+#endif // STIRRER_H
