diff --git a/src/Stirrer.cpp b/src/Stirrer.cpp
new file mode 100644
index 0000000..6922600
--- /dev/null
+++ b/src/Stirrer.cpp
@@ -0,0 +1,198 @@
+#include "Stirrer.h"
+
+// [VCL] See Stirrer.h. Mirrors byu-vcl's XIAO RP2040 firmware for the same
+// stirrer (hardware/vial-stirrer-cubxl/firmware/main.py), which follows the
+// Pioreactor's stirring.py: an additive P loop, a full-power kick from rest,
+// and a pause-then-kick on stall. Two differences forced by sharing this board:
+//   - nothing here blocks: kicks and pauses are timed phases, and
+//   - nothing is printed unprompted, since every line on this port is a reply
+//     to a command. A stall shows up as `stalled` in the status reply.
+// Pipette moves block loop() for seconds at a time. The PWM and the pulse count
+// carry on in hardware meanwhile, so only the control update (and the end of a
+// kick or a timed run) waits for the move to finish.
+
+enum StirPhase { STIR_RUN, STIR_PAUSE, STIR_KICK };
+
+static volatile uint16_t hallCount = 0;
+static volatile unsigned long lastEdgeUs = 0;
+
+static float target = 0.0f;       // rpm asked for
+static float setpoint = 0.0f;     // ramped toward target
+static float duty = 0.0f;         // 0..1 while running
+static float rpm = 0.0f;          // last measurement
+static bool stalled = false;
+static uint8_t zeroUpdates = 0;
+static unsigned long stopAtMs = 0;    // end of a timed run; 0 = none
+static bool timed = false;
+static StirPhase phase = STIR_RUN;
+static unsigned long phaseUntilMs = 0;
+static unsigned long lastUpdateMs = 0;
+
+static void hallEdge()
+{
+    unsigned long now = micros();
+    if (now - lastEdgeUs >= STIR_MIN_EDGE_US) {
+        hallCount++;
+        lastEdgeUs = now;
+    }
+}
+
+static void applyDuty()
+{
+    uint16_t level;
+    if (target <= 0.0f || phase == STIR_PAUSE) {
+        level = 0;
+    } else if (phase == STIR_KICK) {
+        level = STIR_PWM_TOP;
+    } else {
+        level = (uint16_t)(constrain(duty, 0.0f, 1.0f) * STIR_PWM_TOP + 0.5f);
+    }
+    OCR1B = level;      // 0 holds the output low, TOP holds it high
+}
+
+static void startKick(bool pauseFirst)
+{
+    phase = pauseFirst ? STIR_PAUSE : STIR_KICK;
+    phaseUntilMs = millis() + (pauseFirst ? STIR_PAUSE_MS : STIR_KICK_MS);
+    applyDuty();
+}
+
+static void stopStirrer()
+{
+    target = 0.0f;
+    setpoint = 0.0f;
+    duty = 0.0f;
+    zeroUpdates = 0;
+    timed = false;
+    phase = STIR_RUN;
+    applyDuty();
+}
+
+void setupStirrer()
+{
+    digitalWrite(STIR_PWM_PIN, LOW);
+    pinMode(STIR_PWM_PIN, OUTPUT);
+
+    // Phase-correct PWM, TOP = ICR1 (mode 10), clk/64, non-inverting on OC1B only.
+    TCCR1B = 0;
+    TCCR1A = _BV(COM1B1) | _BV(WGM11);
+    ICR1 = STIR_PWM_TOP;
+    OCR1B = 0;
+    TCNT1 = 0;
+    TCCR1B = _BV(WGM13) | _BV(CS11) | _BV(CS10);
+
+    pinMode(STIR_HALL_PIN, INPUT_PULLUP);
+    attachInterrupt(digitalPinToInterrupt(STIR_HALL_PIN), hallEdge, FALLING);
+
+    stopStirrer();
+    stalled = false;
+    lastUpdateMs = millis();
+}
+
+float setStirrer(float rpmTarget, float seconds)
+{
+    if (!(rpmTarget > 0.0f)) {          // also catches NaN
+        stopStirrer();
+        return 0.0f;
+    }
+    target = constrain(rpmTarget, STIR_RPM_MIN, STIR_RPM_MAX);
+    stalled = false;
+    zeroUpdates = 0;
+    timed = seconds > 0.0f;
+    if (timed) {
+        stopAtMs = millis() + (unsigned long)(seconds * 1000.0f);
+    }
+    if (setpoint <= 0.0f) {             // from rest: start now rather than at the next update
+        setpoint = min(target, STIR_RPM_MIN);
+        duty = STIR_DC_START;
+        noInterrupts();
+        hallCount = 0;                  // count this run's turns only
+        interrupts();
+        lastUpdateMs = millis();
+        startKick(false);
+    } else {
+        applyDuty();
+    }
+    return target;
+}
+
+void updateStirrer()
+{
+    unsigned long now = millis();
+
+    if (timed && (long)(now - stopAtMs) >= 0) {
+        stopStirrer();
+    }
+    if (phase != STIR_RUN && (long)(now - phaseUntilMs) >= 0) {
+        if (phase == STIR_PAUSE) {
+            phase = STIR_KICK;
+            phaseUntilMs = now + STIR_KICK_MS;
+        } else {
+            phase = STIR_RUN;
+        }
+        applyDuty();
+    }
+
+    if (now - lastUpdateMs < STIR_UPDATE_MS) {
+        return;
+    }
+    float dt = (now - lastUpdateMs) / 1000.0f;
+    lastUpdateMs = now;
+
+    noInterrupts();
+    uint16_t n = hallCount;
+    hallCount = 0;
+    interrupts();
+    rpm = n / (float)STIR_PULSES_PER_REV / dt * 60.0f;
+
+    if (target <= 0.0f) {
+        return;
+    }
+    if (phase != STIR_RUN) {            // still kicking: judge it next update
+        return;
+    }
+    if (setpoint <= 0.0f) {             // starting from rest
+        setpoint = min(target, STIR_RPM_MIN);
+        duty = STIR_DC_START;
+        startKick(false);
+        return;
+    }
+
+    float step = STIR_RAMP * dt;
+    setpoint = (setpoint < target) ? min(target, setpoint + step) : max(target, setpoint - step);
+
+    if (rpm < 1.0f) {                   // no pulses: pause, kick, and give up after a few tries
+        if (++zeroUpdates > STIR_STALL_TRIES) {
+            stopStirrer();
+            stalled = true;
+            return;
+        }
+        duty = min(duty * 1.01f, STIR_STALL_DUTY_MAX);
+        startKick(true);
+        return;
+    }
+    zeroUpdates = 0;
+
+    float delta = constrain(STIR_KP * (setpoint - rpm), -STIR_MAX_STEP, STIR_MAX_STEP);
+    duty = constrain(duty + delta, 0.0f, 1.0f);
+    applyDuty();
+}
+
+void sendStirrerStatusResponse()
+{
+    // OK:{"target":600,"setpoint":400,"rpm":387.0,"duty":0.312,"stalled":0,"left_s":120}
+    Serial.print(F("OK:{\"target\":"));
+    Serial.print(target, 0);
+    Serial.print(F(",\"setpoint\":"));
+    Serial.print(setpoint, 0);
+    Serial.print(F(",\"rpm\":"));
+    Serial.print(rpm, 1);
+    Serial.print(F(",\"duty\":"));
+    Serial.print(target > 0.0f ? duty : 0.0f, 3);
+    Serial.print(F(",\"stalled\":"));
+    Serial.print(stalled ? 1 : 0);
+    Serial.print(F(",\"left_s\":"));
+    long left = timed ? (long)(stopAtMs - millis()) : -1000L;
+    Serial.print(timed ? (left > 0 ? left / 1000L : 0L) : -1L);
+    Serial.println(F("}"));
+}
