diff --git a/src/Pipette.cpp b/src/Pipette.cpp
index a04aa9d..b4c8d95 100644
--- a/src/Pipette.cpp
+++ b/src/Pipette.cpp
@@ -316,6 +316,57 @@ bool dispense(float /*volume*/, float velocity)
 
 
 // Get current pipette status
+// [VCL 2026-09-15] Read the TMC2209's own fault flags back over the
+// single-wire UART.  Ben bridged RX_PIN (A0) to TX_PIN (A1) with 10k on
+// 2026-09-15, which is what makes this possible: PDN_UART is half duplex,
+// so the driver answers on the wire it was addressed on, and without the
+// bridge the Arduino can only ever talk.  setupMotor() writes six registers
+// and checks none of them, so before this there was no way to tell a healthy
+// driver from one sitting at minimum current with its output stage off.
+bool getDriverDiagnostics(float* comm, float* flags, float* currentScaling)
+{
+    if (!comm || !flags || !currentScaling) {
+        return false;
+    }
+
+    if (stepperDriver.isSetupAndCommunicating()) {
+        *comm = 2.0;
+    } else if (stepperDriver.isCommunicatingButNotSetup()) {
+        *comm = 1.0;   // powered up after setup(): defaults reloaded
+    } else {
+        *comm = 0.0;   // no reply at all: check VDD, the bridge, the pins
+    }
+
+    uint32_t bits = 0;
+    if (*comm > 0.0) {
+        TMC2209::Status st = stepperDriver.getStatus();
+        if (st.over_temperature_warning)  bits |= DRVSTATUS_OT_WARNING;
+        if (st.over_temperature_shutdown) bits |= DRVSTATUS_OT_SHUTDOWN;
+        if (st.short_to_ground_a)         bits |= DRVSTATUS_SHORT_GND_A;
+        if (st.short_to_ground_b)         bits |= DRVSTATUS_SHORT_GND_B;
+        if (st.low_side_short_a)          bits |= DRVSTATUS_LOW_SIDE_A;
+        if (st.low_side_short_b)          bits |= DRVSTATUS_LOW_SIDE_B;
+        if (st.open_load_a)               bits |= DRVSTATUS_OPEN_LOAD_A;
+        if (st.open_load_b)               bits |= DRVSTATUS_OPEN_LOAD_B;
+        if (st.over_temperature_120c)     bits |= DRVSTATUS_OT_120C;
+        if (st.over_temperature_143c)     bits |= DRVSTATUS_OT_143C;
+        if (st.over_temperature_150c)     bits |= DRVSTATUS_OT_150C;
+        if (st.over_temperature_157c)     bits |= DRVSTATUS_OT_157C;
+        if (st.stealth_chop_mode)         bits |= DRVSTATUS_STEALTH_CHOP;
+        if (st.standstill)                bits |= DRVSTATUS_STANDSTILL;
+        *currentScaling = (float)st.current_scaling;
+    } else {
+        *currentScaling = -1.0;
+    }
+
+    if (stepperDriver.hardwareDisabled()) {
+        bits |= DRVSTATUS_HW_DISABLED;
+    }
+
+    *flags = (float)bits;
+    return true;
+}
