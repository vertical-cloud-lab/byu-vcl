+#define DRVSTATUS_OT_120C        (1UL << 8)
+#define DRVSTATUS_OT_143C        (1UL << 9)
+#define DRVSTATUS_OT_150C        (1UL << 10)
+#define DRVSTATUS_OT_157C        (1UL << 11)
+#define DRVSTATUS_STEALTH_CHOP   (1UL << 12)
+#define DRVSTATUS_STANDSTILL     (1UL << 13)
+#define DRVSTATUS_HW_DISABLED    (1UL << 14)
