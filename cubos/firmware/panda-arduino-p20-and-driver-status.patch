+//   currentScaling: the driver's actual CS value, 0-31
+bool getDriverDiagnostics(float* comm, float* flags, float* currentScaling);
+
+#define DRVSTATUS_OT_WARNING     (1UL << 0)
+#define DRVSTATUS_OT_SHUTDOWN    (1UL << 1)
+#define DRVSTATUS_SHORT_GND_A    (1UL << 2)
+#define DRVSTATUS_SHORT_GND_B    (1UL << 3)
+#define DRVSTATUS_LOW_SIDE_A     (1UL << 4)
