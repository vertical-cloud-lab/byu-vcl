+    def test_disconnect_proceeds_when_stop_fails(self):
+        stirrer = MockStirrer()
+        disconnected = []
+
+        def failing_stop():
+            raise RuntimeError("dead board")
+
+        stirrer.stop = failing_stop
+        original = stirrer.disconnect
+        stirrer.disconnect = lambda: disconnected.append(True) or original()
+        gantry = InstrumentedGantry(controller=None, instruments={"stirrer_1": stirrer})
+        gantry.disconnect_instruments()
+        assert disconnected == [True]
