@@ -0,0 +1,58 @@
+"""In-memory stirrer simulation shared by the mock vendor and offline mode.
+
+Follows the PANDA stirrer firmware closely enough for ``--mock`` runs and
+tests: the setpoint starts at 100 rpm and ramps at 100 rpm/s toward the
+target, the measured speed tracks the setpoint, and a timed stir stops
+itself when its time is up.
+"""
+
+from __future__ import annotations
+
+import time
+from typing import Callable, Optional
+
+from cubos.instruments.stirrer.models import StirrerStatus
+
+RAMP_RPM_PER_S = 100.0
+START_RPM = 100.0
+
+
+class SimulatedStirrer:
+    def __init__(self, clock: Callable[[], float] = time.monotonic) -> None:
+        self._clock = clock
+        self.target = 0.0
+        self._t_start = 0.0
+        self._stop_at: Optional[float] = None
+
+    def set(self, rpm: float, seconds: Optional[float]) -> float:
+        if rpm <= 0:
+            self.stop()
+            return 0.0
+        if self.target <= 0:
+            self._t_start = self._clock()
+        self.target = float(rpm)
+        self._stop_at = self._clock() + seconds if seconds else None
+        return self.target
+
+    def stop(self) -> None:
+        self.target = 0.0
+        self._stop_at = None
+
+    def finish_timed_run(self) -> None:
+        """Jump to the end of a timed stir (offline waits need no real sleep)."""
+        if self._stop_at is not None:
+            self.stop()
+
+    def status(self) -> StirrerStatus:
+        now = self._clock()
+        if self._stop_at is not None and now >= self._stop_at:
+            self.stop()
+        if self.target <= 0:
+            return StirrerStatus()
+        setpoint = min(self.target, START_RPM + RAMP_RPM_PER_S * (now - self._t_start))
+        left = None if self._stop_at is None else max(0.0, self._stop_at - now)
+        return StirrerStatus(
+            target_rpm=self.target, setpoint_rpm=setpoint, rpm=setpoint,
+            duty=round(0.3 + 0.3 * setpoint / max(self.target, 1.0), 3),
+            stalled=False, seconds_left=left,
+        )
diff --git a/packages/core/src/cubos/instruments/stirrer/vendors/mock.py b/packages/core/src/cubos/instruments/stirrer/vendors/mock.py
new file mode 100644
