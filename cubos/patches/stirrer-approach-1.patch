index 0000000..88fb612
--- /dev/null
+++ b/packages/core/src/cubos/instruments/stirrer/interface.py
@@ -0,0 +1,95 @@
+"""Generic magnetic stirrer interface.
+
+A stirrer is **deck-mounted**: it sits under labware on the deck and never
+rides on the gantry head. Its registry entry says ``mount: deck``, so the
+head-geometry code (bounds and home-pose validation, calibration, motion
+targets) skips it, and its gantry YAML entry carries a driver and a port but
+no ``offset_x``/``offset_y``/``depth``. Where it is on the deck, as an
+obstacle, belongs in the deck file.
+
+Sequencing belongs to the ``stir`` protocol command. As a fail-safe,
+``InstrumentedGantry.disconnect_instruments`` stops every stirrer at the end
+of every run, the way it turns every light off.
+"""
+
+from __future__ import annotations
+
+from abc import abstractmethod
+from typing import Optional
+
+from cubos.instruments.base_instrument import BaseInstrument
+from cubos.instruments.stirrer.exceptions import StirrerConfigError
+from cubos.instruments.stirrer.models import StirrerStatus
+
+
+class StirrerInstrument(BaseInstrument):
+    """Base class for magnetic stirrer implementations."""
+
+    mount = "deck"
+
+    #: Slowest and fastest non-zero speeds the vendor accepts, rpm.
+    MIN_RPM: float = 0.0
+    MAX_RPM: float = float("inf")
+
+    def __init__(
+        self,
+        name: Optional[str] = None,
+        offset_x: float = 0.0,
+        offset_y: float = 0.0,
+        depth: float = 0.0,
+        offline: bool = False,
+    ):
+        super().__init__(
+            name=name,
+            offset_x=offset_x,
+            offset_y=offset_y,
+            depth=depth,
+            offline=offline,
+        )
+
+    @abstractmethod
+    def set_speed(self, rpm: float, seconds: Optional[float] = None) -> float:
+        """Stir at *rpm*; with *seconds*, the stirrer stops itself after that long.
+
+        ``rpm`` 0 stops. Returns the target speed actually set.
+        """
+
+    @abstractmethod
+    def stop(self) -> None:
+        """Stop stirring."""
+
+    @abstractmethod
+    def status(self) -> StirrerStatus:
+        """Return the current speed reading."""
+
+    @abstractmethod
+    def wait_until_stopped(self, timeout: float) -> StirrerStatus:
+        """Block until a timed stir has ended (or *timeout* s pass).
+
+        Raises :class:`StirrerTimeoutError` if it is still running then.
+        """
+
+    def validate_speed(self, rpm: float, seconds: Optional[float] = None) -> None:
+        """Shared range checks, so a bad step fails in ``--mock`` too."""
+        try:
+            rpm = float(rpm)
+        except (TypeError, ValueError) as exc:
+            raise StirrerConfigError(f"rpm must be a number, got {rpm!r}") from exc
+        if rpm != rpm or rpm < 0:                     # NaN or negative
+            raise StirrerConfigError(f"rpm must be >= 0, got {rpm!r}")
+        if rpm > 0 and not (self.MIN_RPM <= rpm <= self.MAX_RPM):
+            raise StirrerConfigError(
+                f"rpm {rpm:g} is outside {self.name}'s range "
+                f"{self.MIN_RPM:g}-{self.MAX_RPM:g} (0 stops)."
+            )
+        if seconds is not None:
+            try:
+                seconds = float(seconds)
+            except (TypeError, ValueError) as exc:
+                raise StirrerConfigError(
+                    f"seconds must be a number, got {seconds!r}"
+                ) from exc
+            if not seconds > 0:
+                raise StirrerConfigError(f"seconds must be > 0, got {seconds!r}")
+            if rpm == 0:
+                raise StirrerConfigError("seconds needs a non-zero rpm.")
