+++ b/packages/core/src/cubos/instruments/stirrer/vendors/mock.py
@@ -0,0 +1,63 @@
+"""Offline mock stirrer vendor for dry runs and tests."""
+
+from __future__ import annotations
+
+from typing import List, Optional
+
+from cubos.instruments.stirrer.interface import StirrerInstrument
+from cubos.instruments.stirrer.models import StirrerStatus
+from cubos.instruments.stirrer.vendors._sim import SimulatedStirrer
+
+
+class MockStirrer(StirrerInstrument):
+    """Deterministic in-memory stirrer. ``actuation_log`` records every call."""
+
+    MIN_RPM = 100.0
+    MAX_RPM = 2000.0
+
+    def __init__(
+        self,
+        *,
+        name: Optional[str] = None,
+        offset_x: float = 0.0,
+        offset_y: float = 0.0,
+        depth: float = 0.0,
+        offline: bool = True,
+        **kwargs,
+    ):
+        super().__init__(
+            name=name, offset_x=offset_x, offset_y=offset_y,
+            depth=depth, offline=offline,
+        )
+        self._sim = SimulatedStirrer()
+        self.actuation_log: List[str] = []
+
+    def connect(self) -> None:
+        self._sim.stop()
+        self.logger.info("MockStirrer connected (offline)")
+
+    def disconnect(self) -> None:
+        self._sim.stop()
+        self.logger.info("MockStirrer disconnected (offline)")
+
+    def health_check(self) -> bool:
+        return True
+
+    def set_speed(self, rpm: float, seconds: Optional[float] = None) -> float:
+        self.validate_speed(rpm, seconds)
+        self.actuation_log.append(
+            f"set_speed {float(rpm):g}" + (f" {float(seconds):g}s" if seconds else "")
+        )
+        return self._sim.set(float(rpm), float(seconds) if seconds else None)
+
+    def stop(self) -> None:
+        self.actuation_log.append("stop")
+        self._sim.stop()
+
+    def status(self) -> StirrerStatus:
+        return self._sim.status()
+
+    def wait_until_stopped(self, timeout: float) -> StirrerStatus:
+        self.actuation_log.append("wait_until_stopped")
+        self._sim.finish_timed_run()
+        return self._sim.status()
