+"""Stirrer instrument data models."""
+
+from __future__ import annotations
+
+from typing import Optional
+
+from pydantic import BaseModel, ConfigDict, Field
+
+
+class StirrerStatus(BaseModel):
+    """One status reading from a stirrer.
+
+    ``target_rpm`` is what was asked for (after the vendor's clamp; 0 when
+    stopped), ``setpoint_rpm`` the ramped value the speed loop is chasing,
+    ``rpm`` the last measured speed. ``seconds_left`` is ``None`` unless a
+    timed stir is running.
+    """
+
+    model_config = ConfigDict(extra="forbid")
+
+    target_rpm: float = Field(0.0, description="Target speed, rpm (0 = stopped).")
+    setpoint_rpm: float = Field(0.0, description="Ramped setpoint, rpm.")
+    rpm: float = Field(0.0, description="Last measured speed, rpm.")
+    duty: float = Field(0.0, description="Drive duty cycle, 0-1.")
+    stalled: bool = Field(False, description="The speed loop gave up on a stall.")
+    seconds_left: Optional[float] = Field(
+        None, description="Time left on a timed stir; None when untimed or stopped.",
+    )
+
+    @property
+    def running(self) -> bool:
+        return self.target_rpm > 0
