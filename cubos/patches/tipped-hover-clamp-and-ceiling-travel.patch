diff --git a/packages/core/src/cubos/gantry/instrument_mount.py b/packages/core/src/cubos/gantry/instrument_mount.py
index 195393a..0b691be 100644
--- a/packages/core/src/cubos/gantry/instrument_mount.py
+++ b/packages/core/src/cubos/gantry/instrument_mount.py
@@ -106,7 +106,50 @@ class InstrumentedGantry:
         instr = self._resolve_instrument(instrument)
         x, y, z = self._resolve_position(labware)
         self._validate_finite_xyz(x, y, z, instr.name)
-        self.move(instr, (x, y, self.safe_z), travel_z=self.safe_z)
+        hover_z = self.safe_z
+        travel_z = self.safe_z
+        ceiling = self._gantry_z_ceiling()
+        if ceiling is not None:
+            # Travel with the carriage at the top of the working volume so
+            # every tool mounted on the head — not just the active
+            # instrument — clears the deck (upstream 0cc5028). safe_z
+            # remains the approach hover and retract plane.
+            reach_limit = ceiling - self._effective_depth(instr)
+            travel_z = max(travel_z, reach_limit)
+            if reach_limit < hover_z:
+                # A deep tool point (e.g. a pipette carrying a disposable
+                # tip) can sit so far below the carriage that putting it at
+                # safe_z would need gantry Z above working_volume.z_max.
+                # Hover at the highest plane the carriage can actually
+                # reach instead of commanding an out-of-travel Z. Warn
+                # loudly: the tool point crosses the deck BELOW safe_z, so
+                # the operator must confirm this plane clears every labware
+                # (offline validation only models the machine's fixed
+                # structures, not labware heights).
+                self.logger.warning(
+                    "%s cannot reach safe_z %.3f (tool point rides %.3f "
+                    "below the carriage; ceiling %.3f). Hovering/traveling "
+                    "at %.3f instead — confirm this plane clears all deck "
+                    "contents.",
+                    instr.name, hover_z, self._effective_depth(instr),
+                    ceiling, reach_limit,
+                )
+                hover_z = reach_limit
+                travel_z = reach_limit
+        self.move(instr, (x, y, hover_z), travel_z=travel_z)
+
+    def _gantry_z_ceiling(self) -> float | None:
+        """Gantry-frame z_max from the controller config, if available."""
+        config = getattr(self.controller, 'config', None)
+        if not isinstance(config, dict):
+            return None
+        volume = config.get('working_volume')
+        if not isinstance(volume, dict):
+            return None
+        z_max = volume.get('z_max')
+        if isinstance(z_max, (int, float)) and math.isfinite(float(z_max)):
+            return float(z_max)
+        return None
 
