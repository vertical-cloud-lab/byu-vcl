index 4a5c255..d834a1a 100644
--- a/packages/core/src/cubos/gantry/gantry_config.py
+++ b/packages/core/src/cubos/gantry/gantry_config.py
@@ -125,3 +125,19 @@ class GantryConfig:
     def resolved_safe_z(self) -> float:
         """Effective safe travel Z: explicit ``safe_z`` or ``working_volume.z_max``."""
         return self.safe_z if self.safe_z is not None else self.working_volume.z_max
+
+    def hover_z(self, instrument: str, tip_extension: float = 0.0) -> float:
+        """Highest tool-frame plane *instrument* can hover/travel at.
+
+        ``resolved_safe_z``, unless the instrument's tool point rides so far
+        below the carriage (``depth`` plus an attached-tip extension) that
+        putting it at ``resolved_safe_z`` would need gantry Z above
+        ``working_volume.z_max``; then the highest plane the carriage can
+        actually reach. Mirrors ``InstrumentedGantry.move_to_labware``.
+        """
+        config = self.instruments.get(instrument)
+        depth = config.get("depth", 0.0) if isinstance(config, dict) else 0.0
+        if isinstance(depth, bool) or not isinstance(depth, (int, float)):
+            depth = 0.0
+        reach_limit = self.working_volume.z_max - float(depth) - float(tip_extension)
+        return min(self.resolved_safe_z, reach_limit)
