+    # config, which would blind InstrumentedGantry._gantry_z_ceiling() and
+    # let dry-run travel planes diverge from hardware. Seed the controller's
+    # working volume from the loaded machine config so mock and hardware
+    # plan the same motion.
+    working_volume = getattr(config, "working_volume", None)
+    if (
+        isinstance(gantry.config, dict)
+        and "working_volume" not in gantry.config
+        and working_volume is not None
+    ):
+        gantry.config["working_volume"] = {
+            "x_min": working_volume.x_min,
+            "x_max": working_volume.x_max,
+            "y_min": working_volume.y_min,
+            "y_max": working_volume.y_max,
+            "z_min": working_volume.z_min,
+            "z_max": working_volume.z_max,
+        }
     return build_instrumented_gantry(
         instrument_configs,
         gantry,
