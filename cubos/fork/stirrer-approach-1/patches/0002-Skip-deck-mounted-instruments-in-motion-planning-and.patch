+class TestPlannerAndOffsetCalibration:
+    """Head-geometry code that is newer than approach 1's first draft."""
+
+    _BOX = {"offset": {"x": -5, "y": -5, "z": 0}, "size": {"x": 10, "y": 10, "z": 20}}
+
+    def test_planner_scene_skips_deck_mounted(self):
+        from types import SimpleNamespace
+
+        from cubos.protocol_engine.routing import _build_scene_from_context
+
+        context = SimpleNamespace(
+            gantry_config=SimpleNamespace(working_volume=SimpleNamespace(
+                x_min=0, x_max=300, y_min=0, y_max=200, z_min=0, z_max=120,
+            )),
+            deck=SimpleNamespace(labware={}, motion_planning={}),
+            gantry=SimpleNamespace(
+                instruments={"cam": MountOnlyCamera(offline=True), "stirrer_1": MockStirrer()},
+                motion_envelopes={"cam": {"box": self._BOX}},   # none for the stirrer
+            ),
+        )
+        scene = _build_scene_from_context(context)
+        assert [tool.name for tool in scene.tool_envelopes] == ["cam"]
+
+    def test_loader_rejects_motion_envelope_on_deck_instrument(self):
+        from cubos.gantry.instrument_loader import build_instrumented_gantry
+
+        with pytest.raises(ValueError, match="deck-mounted"):
+            build_instrumented_gantry(
+                {"stirrer_1": {"type": "stirrer", "vendor": "mock"}},
+                None,
+                motion_envelopes={"stirrer_1": {"box": self._BOX}},
+            )
+
+    @staticmethod
