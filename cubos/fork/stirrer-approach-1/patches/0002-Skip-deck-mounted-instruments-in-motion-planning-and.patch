+def _reject_deck_mounted_envelopes(
+    instruments: Mapping[str, BaseInstrument],
+    motion_envelopes: Mapping[str, Any] | None,
+) -> None:
+    """A motion_envelope describes a tool on the head: refuse one on a deck instrument."""
+    deck_mounted = sorted(
+        name for name in (motion_envelopes or {})
+        if name in instruments and is_deck_mounted_instrument(instruments[name])
+    )
+    if deck_mounted:
+        raise ValueError(
+            f"Instrument(s) {', '.join(deck_mounted)} are deck-mounted, so they "
+            "have no motion_envelope; remove it. Their place on the deck "
+            "belongs in the deck file."
+        )
+
