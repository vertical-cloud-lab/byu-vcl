+        return {
+            "instruments": {
+                "pipette": {"type": "pipette", "vendor": "opentrons", "offset_x": 55,
+                            "offset_y": 11, "depth": 0},
+                "camera": {"type": "camera", "vendor": "mount_only", "offset_x": -40,
+                           "offset_y": 10, "depth": -110},
+                "stirrer_1": {"type": "stirrer", "vendor": "pawduino", "port": "/dev/ttyACM0"},
+            },
+        }
+
+    def test_offset_calibration_needs_no_capture_for_deck_mounted(self):
+        from cubos.gantry.offset_calibration import calibrate_instrument_offsets
+
+        config = self._offset_config()
+        captures = {
+            "pipette": {"x": 100, "y": 50, "z": 20},
+            "camera": {"x": 90, "y": 55, "z": 40, "stand_off_mm": 30},
+        }
+        result = calibrate_instrument_offsets(config, "pipette", captures)
+        assert result["instruments"]["stirrer_1"] == config["instruments"]["stirrer_1"]
+        assert result["instruments"]["camera"]["offset_x"] == 65
+
+    def test_deck_mounted_cannot_be_offset_reference(self):
+        from cubos.gantry.offset_calibration import calibrate_instrument_offsets
+
+        with pytest.raises(ValueError, match="reference"):
+            calibrate_instrument_offsets(
+                self._offset_config(), "stirrer_1",
+                {"pipette": {"x": 1, "y": 1, "z": 1}, "stirrer_1": {"x": 1, "y": 1, "z": 1}},
+            )
