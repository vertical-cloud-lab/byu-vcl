@@ -34,9 +34,17 @@ def calibrate_instrument_offsets(
     next_config = deepcopy(dict(config))
     instruments = next_config.get("instruments", {})
     reference = instruments.get(reference_instrument)
-    if not reference or reference.get("type") in {"camera", "lighting"}:
+    if (
+        not reference
+        or reference.get("type") in {"camera", "lighting"}
+        or _is_deck_mounted_entry(reference)
+    ):
         raise ValueError("Choose an already calibrated contact instrument as reference.")
-    required = {name for name, entry in instruments.items() if entry.get("type") != "lighting"}
+    # Deck-mounted instruments (a stirrer) have no head offsets to measure.
+    required = {
+        name for name, entry in instruments.items()
+        if entry.get("type") != "lighting" and not _is_deck_mounted_entry(entry)
+    }
     if set(captures) != required:
         raise ValueError("Record every contact instrument and camera at the same fixed mark.")
 
@@ -79,3 +87,16 @@ def calibrate_instrument_offsets(
             for field in ("offset_x", "offset_y", "depth"):
                 entry[field] = camera.get(field, 0)
     return next_config
+
+
+def _is_deck_mounted_entry(entry: Mapping[str, Any]) -> bool:
+    """True when a gantry YAML entry's type is registered ``mount: deck``."""
+    from cubos.instruments.registry import is_deck_mounted
+
+    type_key = entry.get("type") if isinstance(entry, Mapping) else None
+    if not type_key:
+        return False
+    try:
+        return is_deck_mounted(str(type_key))
+    except ValueError:                  # unknown type: let validation report it
+        return False
