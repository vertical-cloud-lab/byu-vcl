new file mode 100644
index 0000000..3746aae
--- /dev/null
+++ b/packages/core/src/cubos/protocol_engine/commands/stir.py
@@ -0,0 +1,97 @@
+"""Protocol command: run a magnetic stirrer.
+
+Built on the vendor-agnostic ``StirrerInstrument`` surface: each step is one
+``set_stirrer_params`` call, and a blocking step then waits on
+``get_stirrer_params``. The stirrer is deck-mounted (approach 1): the step
+names the stirrer, not the vial on it, so the protocol author decides what is
+being stirred. Stirrers the protocol leaves running, the run teardown stops
+(``InstrumentedGantry.disconnect_instruments``).
+
+    - stir:
+        instrument: stirrer_1
+        rpm: 600          # 0 stops
+        seconds: 60       # optional: the stirrer stops itself after this long
+        wait: false       # optional: default true when seconds is given
+
+With ``seconds`` and ``wait`` left at its default, the step blocks until the
+stir has ended. With ``wait: false`` the protocol carries on while it stirs;
+``seconds`` is then a limit the stirrer enforces itself, even if the host
+goes away. Without ``seconds`` it stirs until a later ``rpm: 0`` step or the
+end of the run. (``rpm: 0`` rather than ``off: true``, because YAML parses a
+bare ``off`` as a boolean.)
+"""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING
+
+from cubos.instruments.stirrer.exceptions import StirrerError
+from cubos.instruments.stirrer.interface import StirrerInstrument
+
+from ..errors import ProtocolExecutionError
+from ..registry import protocol_command
+from . import _summaries
+
+if TYPE_CHECKING:
+    from ..runtime import ProtocolContext
+
+# Extra time a blocking stir may take beyond its own duration: the firmware
+# checks its timer between other work, so it can end a little late.
+_WAIT_MARGIN_S = 10.0
+
+
+def _get_stirrer(context: "ProtocolContext", instrument: str) -> StirrerInstrument:
+    try:
+        stirrer = context.gantry.instruments[instrument]
+    except KeyError as exc:
+        raise ProtocolExecutionError(
+            f"No instrument {instrument!r} registered on the gantry."
+        ) from exc
+    if not isinstance(stirrer, StirrerInstrument):
+        raise ProtocolExecutionError(
+            f"Instrument {instrument!r} is a {type(stirrer).__name__}, not a "
+            "StirrerInstrument. stir requires a `stirrer` type instrument."
+        )
+    return stirrer
+
+
+@protocol_command("stir", summary=_summaries.stir)
+def stir(
+    context: "ProtocolContext",
+    instrument: str,
+    rpm: float,
+    seconds: float | None = None,
+    wait: bool | None = None,
+) -> None:
+    """Start, change or stop a stirrer.
+
+    Args:
+        context:    Runtime context.
+        instrument: Name of a ``stirrer`` instrument in the gantry file.
+        rpm:        Target speed; 0 stops.
+        seconds:    Optional duration; the stirrer stops itself after it.
+        wait:       Block until a timed stir ends. Defaults to true when
+                    ``seconds`` is given; needs ``seconds``.
+    """
+    stirrer = _get_stirrer(context, instrument)
+    blocking = (seconds is not None) if wait is None else bool(wait)
+    if blocking and seconds is None:
+        raise ProtocolExecutionError(
+            "stir: `wait: true` needs `seconds` (an untimed stir never ends "
+            "on its own)."
+        )
+    try:
+        if float(rpm) == 0:
+            if seconds is not None:
+                raise ProtocolExecutionError("stir: `seconds` needs a non-zero rpm.")
+            stirrer.set_stirrer_params(0)
+            return
+        stirrer.set_stirrer_params(rpm, seconds)
+        if blocking:
+            status = stirrer.wait_until_stopped(float(seconds) + _WAIT_MARGIN_S)
+            if status.stalled:
+                context.logger.warning(
+                    "stir: %s stalled during the stir and stopped itself.", instrument,
+                )
+    except StirrerError as exc:
+        raise ProtocolExecutionError(f"stir: {exc}") from exc
