@@ -0,0 +1,60 @@
+"""Offline mock stirrer vendor for dry runs and tests."""
+
+from __future__ import annotations
+
+from typing import List, Optional
+
+from cubos.instruments.stirrer.interface import StirrerInstrument
+from cubos.instruments.stirrer.models import StirrerStatus
+from cubos.instruments.stirrer.vendors._sim import SimulatedStirrer
+
+
+class MockStirrer(StirrerInstrument):
+    """Deterministic in-memory stirrer. ``actuation_log`` records every call."""
+
+    MIN_RPM = 100.0
+    MAX_RPM = 2000.0
+
+    def __init__(
+        self,
+        *,
+        name: Optional[str] = None,
+        offset_x: float = 0.0,
+        offset_y: float = 0.0,
+        depth: float = 0.0,
+        offline: bool = True,
+        **kwargs,
+    ):
+        super().__init__(
+            name=name, offset_x=offset_x, offset_y=offset_y,
+            depth=depth, offline=offline,
+        )
+        self._sim = SimulatedStirrer()
+        self.actuation_log: List[str] = []
+
+    def connect(self) -> None:
+        self._sim.stop()
+        self.logger.info("MockStirrer connected (offline)")
+
+    def disconnect(self) -> None:
+        self._sim.stop()
+        self.logger.info("MockStirrer disconnected (offline)")
+
+    def health_check(self) -> bool:
+        return True
+
+    def set_stirrer_params(self, rpm: float, seconds: Optional[float] = None) -> float:
+        self.validate_stirrer_params(rpm, seconds)
+        entry = f"set_stirrer_params {float(rpm):g}"
+        if seconds is not None:
+            entry += f" {float(seconds):g}s"
+        self.actuation_log.append(entry)
+        return self._sim.set(float(rpm), float(seconds) if seconds is not None else None)
+
+    def get_stirrer_params(self) -> StirrerStatus:
+        return self._sim.status()
+
+    def wait_until_stopped(self, timeout: float) -> StirrerStatus:
+        self.actuation_log.append("wait_until_stopped")
+        self._sim.finish_timed_run()
+        return self._sim.status()
diff --git a/packages/core/src/cubos/instruments/stirrer/vendors/pawduino.py b/packages/core/src/cubos/instruments/stirrer/vendors/pawduino.py
new file mode 100644
index 0000000..b0fa716
--- /dev/null
+++ b/packages/core/src/cubos/instruments/stirrer/vendors/pawduino.py
@@ -0,0 +1,275 @@
+"""Pawduino magnetic stirrer: the VCL stir module on the PANDA Arduino.
+
+The two high-level calls each send one firmware command (byu-vcl
+``cubos/firmware/panda-arduino-stirrer.patch``):
+
+* :meth:`PawduinoStirrer.set_stirrer_params` sends ``30,<rpm>[,<seconds>]``:
+  stir at *rpm* (the firmware clamps 100-2000); with *seconds* the firmware
+  stops itself after that long. ``30,0`` stops. Replies
+  ``OK:{"msg":"Stirring","v":[<rpm set>,<seconds>]}`` or
+  ``OK:{"msg":"Stirrer off"}``.
+* :meth:`PawduinoStirrer.get_stirrer_params` sends ``31``, which replies
+  ``OK:{"target","setpoint","rpm","duty","stalled","left_s"}`` (``left_s``
+  is -1 when the stir is untimed).
+
+Speed control is closed-loop in the firmware (Hall sensor, setpoint ramp,
+start kick, stall recovery), so the host only sets targets and reads status.
+Uses the shared ``PawduinoLink`` (the capper and pipette share this board) and
+never opens the port itself. Pass ``offline=True`` for dry runs.
+
+With ``status_poll_s`` > 0, a background thread reads ``31`` that often while
+the stirrer runs and logs each reading, so a run log shows the speed between
+protocol steps. The link's lock keeps those reads from interleaving with the
+capper's and pipette's commands.
+"""
+
+from __future__ import annotations
+
+import json
+import threading
+import time
+from typing import List, Optional, Tuple
+
+from cubos.instruments.controllers.pawduino import (
+    PawduinoLink,
+    PawduinoLinkCommandError,
+    PawduinoLinkError,
+    PawduinoLinkTimeoutError,
+)
+from cubos.instruments.stirrer.exceptions import (
+    StirrerCommandError,
+    StirrerConnectionError,
+    StirrerTimeoutError,
+)
+from cubos.instruments.stirrer.interface import StirrerInstrument
+from cubos.instruments.stirrer.models import StirrerStatus
+from cubos.instruments.stirrer.vendors._sim import SimulatedStirrer
+
+_CMD_STIR = 30
+_CMD_STIR_STATUS = 31
+
+
+def parse_status(reply: str) -> StirrerStatus:
+    """Parse a ``31`` reply into a :class:`StirrerStatus`."""
+    try:
+        body = json.loads(reply.split(":", 1)[1])
+    except (IndexError, ValueError) as exc:
+        raise StirrerCommandError(f"Unparseable stirrer status {reply!r}") from exc
+    left = float(body.get("left_s", -1))
+    return StirrerStatus(
+        target_rpm=float(body.get("target", 0)),
+        setpoint_rpm=float(body.get("setpoint", 0)),
+        rpm=float(body.get("rpm", 0)),
+        duty=float(body.get("duty", 0)),
+        stalled=bool(int(body.get("stalled", 0))),
+        seconds_left=None if left < 0 else left,
+    )
+
+
+class PawduinoStirrer(StirrerInstrument):
+    """Single magnetic stirrer on the shared PANDA Arduino serial link."""
+
+    MIN_RPM = 100.0
+    MAX_RPM = 2000.0
+
+    def __init__(
+        self,
+        *,
+        port: str = "",
+        baud_rate: int = 115200,
+        command_timeout: float = 10.0,
+        status_poll_s: float = 0.0,
+        name: Optional[str] = None,
+        offset_x: float = 0.0,
+        offset_y: float = 0.0,
+        depth: float = 0.0,
+        offline: bool = False,
+        **kwargs,
+    ):
+        super().__init__(
+            name=name,
+            offset_x=offset_x,
+            offset_y=offset_y,
+            depth=depth,
+            offline=offline,
+        )
+        self._port = port
+        self._baud_rate = baud_rate
+        self._command_timeout = command_timeout
+        self._status_poll_s = float(status_poll_s or 0.0)
+        self._link: Optional[PawduinoLink] = None
+        self._sim = SimulatedStirrer()
+        self._poller: Optional[threading.Thread] = None
+        self._poll_stop = threading.Event()
+        #: (monotonic time, status) for every reading taken, in order.
+        self.readings: List[Tuple[float, StirrerStatus]] = []
+
+    # -- BaseInstrument interface -------------------------------------------
+
+    def connect(self) -> None:
+        if self._offline:
+            self._sim.stop()
+            self.logger.info("Stirrer connected (offline)")
+            return
+        try:
+            self._link = PawduinoLink.acquire(self._port, self._baud_rate)
+            self._link.connect(timeout=max(self._command_timeout, 30.0))
+        except PawduinoLinkError as exc:
+            self._link = None
+            raise StirrerConnectionError(str(exc)) from exc
+        # A known state, and proof that this firmware has the stir commands.
+        try:
+            self._send_command(_CMD_STIR, 0)
+            status = self.get_stirrer_params()
+        except (StirrerCommandError, StirrerTimeoutError) as exc:
+            self._release_link()
+            raise StirrerConnectionError(
+                f"The Arduino on {self._port} did not accept stirrer commands "
+                f"30/31 ({exc}). Is the stirrer firmware flashed?"
+            ) from exc
+        self.logger.info(
+            "Connected to stirrer on %s (stopped; last rpm %.0f)",
+            self._port, status.rpm,
+        )
+
+    def disconnect(self) -> None:
+        self._stop_poller()
+        if self._offline:
+            self._sim.stop()
+            self.logger.info("Stirrer disconnected (offline)")
+            return
+        if self._link is not None and self._link.is_open:
+            try:
+                self._send_command(_CMD_STIR, 0)
+            except (StirrerCommandError, StirrerTimeoutError) as exc:
+                self.logger.warning("Stirrer stop on disconnect failed: %s", exc)
+        self._release_link()
+        self.logger.info("Disconnected from stirrer")
+
+    def health_check(self) -> bool:
+        if self._offline:
+            return True
+        return self._link is not None and self._link.is_open
+
+    # -- StirrerInstrument interface ----------------------------------------
+
+    def set_stirrer_params(self, rpm: float, seconds: Optional[float] = None) -> float:
+        """Firmware command ``30,<rpm>[,<seconds>]``; ``30,0`` when *rpm* is 0."""
+        self.validate_stirrer_params(rpm, seconds)
+        rpm = float(rpm)
+        seconds = float(seconds) if seconds is not None else None
+        if rpm == 0:
+            self._stop_poller()
+            if self._offline:
+                self._sim.stop()
+            else:
+                self._send_command(_CMD_STIR, 0)
+            self.logger.info("Stirrer stopped")
+            if not self._offline:
+                self._log_status(self.get_stirrer_params())
+            return 0.0
+        if self._offline:
+            target = self._sim.set(rpm, seconds)
+        else:
+            args = (rpm, seconds) if seconds is not None else (rpm,)
+            reply = self._send_command(_CMD_STIR, *args)
+            target = rpm
+            try:
+                target = float(json.loads(reply.split(":", 1)[1])["v"][0])
+            except (IndexError, KeyError, TypeError, ValueError):
+                pass
+        self.logger.info(
+            "Stirrer -> %.0f rpm%s", target,
+            f" for {seconds:g} s" if seconds is not None else " until stopped",
+        )
+        self._start_poller()
+        return target
+
+    def get_stirrer_params(self) -> StirrerStatus:
+        """Firmware command ``31``: the stirrer's current status."""
+        if self._offline:
+            status = self._sim.status()
+        else:
+            status = parse_status(self._send_command(_CMD_STIR_STATUS))
+        self.readings.append((time.monotonic(), status))
+        return status
+
+    def wait_until_stopped(self, timeout: float) -> StirrerStatus:
+        if self._offline:
+            self._sim.finish_timed_run()
+            return self.get_stirrer_params()
+        # This loop reads and logs the status itself, so the poller would
+        # only double the reads.
+        self._stop_poller()
+        deadline = time.monotonic() + timeout
+        while True:
+            status = self.get_stirrer_params()
+            self._log_status(status)
+            if not status.running:
+                return status
+            if time.monotonic() >= deadline:
+                raise StirrerTimeoutError(
+                    f"Stirrer still at target {status.target_rpm:.0f} rpm "
+                    f"after {timeout:g} s."
+                )
+            time.sleep(1.0)
+
+    # -- Status polling -------------------------------------------------------
+
+    def _log_status(self, s: StirrerStatus) -> None:
+        self.logger.info(
+            "Stirrer status: rpm %.0f, setpoint %.0f, target %.0f, duty %.3f%s%s",
+            s.rpm, s.setpoint_rpm, s.target_rpm, s.duty,
+            ", STALLED" if s.stalled else "",
+            f", {s.seconds_left:.0f} s left" if s.seconds_left is not None else "",
+        )
+
+    def _start_poller(self) -> None:
+        if self._offline or self._status_poll_s <= 0:
+            return
+        if self._poller is not None and self._poller.is_alive():
+            return
+        self._poll_stop.clear()
+        self._poller = threading.Thread(
+            target=self._poll, name=f"{self.name}-status", daemon=True,
+        )
+        self._poller.start()
+
+    def _stop_poller(self) -> None:
+        poller = self._poller
+        if poller is None:
+            return
+        self._poll_stop.set()
+        if poller is not threading.current_thread():
+            poller.join(timeout=self._command_timeout + 2.0)
+        self._poller = None
+
+    def _poll(self) -> None:
+        while not self._poll_stop.wait(self._status_poll_s):
+            try:
+                status = self.get_stirrer_params()
+            except Exception as exc:                     # noqa: BLE001
+                self.logger.warning("Stirrer status poll failed: %s", exc)
+                continue
+            self._log_status(status)
+            if not status.running:                       # timed run ended, or a stall
+                return
+
+    # -- Private helpers -------------------------------------------------------
+
+    def _send_command(self, code: int, *args: float) -> str:
+        if self._link is None:
+            raise StirrerCommandError("Not connected to Arduino")
+        try:
+            return self._link.send_command(
+                code, *args, timeout=self._command_timeout,
+            )
+        except PawduinoLinkTimeoutError as exc:
+            raise StirrerTimeoutError(str(exc)) from exc
+        except PawduinoLinkCommandError as exc:
+            raise StirrerCommandError(str(exc)) from exc
+
+    def _release_link(self) -> None:
+        if self._link is not None:
+            self._link.disconnect()
+            self._link = None
