+"""Tests for the stirrer interface, its vendors, and deck-mounted handling."""
+
+from __future__ import annotations
+
+import json
+from unittest.mock import MagicMock
+
+import pytest
+
+from cubos.gantry.instrument_loader import _instantiate_instruments
+from cubos.gantry.instrument_mount import InstrumentedGantry
+from cubos.instruments.base_instrument import BaseInstrument
+from cubos.instruments.camera.vendors.mount_only import MountOnlyCamera
+from cubos.instruments.controllers.pawduino import PawduinoLink
+from cubos.instruments.registry import (
+    get_instrument_class,
+    get_mount,
+    is_deck_mounted,
+)
+from cubos.instruments.stirrer.exceptions import (
+    StirrerConfigError,
+    StirrerConnectionError,
+)
+from cubos.instruments.stirrer.interface import StirrerInstrument
+from cubos.instruments.stirrer.vendors.mock import MockStirrer
+from cubos.instruments.stirrer.vendors.pawduino import PawduinoStirrer, parse_status
+from cubos.protocol_engine.commands._summaries import stir as stir_summary
+from cubos.protocol_engine.commands.stir import stir
+from cubos.protocol_engine.errors import ProtocolExecutionError
+from cubos.protocol_engine.runtime import ProtocolContext
+
+STATUS_RUNNING = 'OK:{"target":600,"setpoint":300,"rpm":290.0,"duty":0.412,"stalled":0,"left_s":-1}'
+STATUS_STOPPED = 'OK:{"target":0,"setpoint":0,"rpm":0.0,"duty":0.000,"stalled":0,"left_s":-1}'
+
+
+@pytest.fixture(autouse=True)
+def _fresh_links():
+    PawduinoLink.reset_registry()
+    yield
+    PawduinoLink.reset_registry()
+
+
+def _linked_stirrer(responses, **kwargs):
+    """Pawduino stirrer on a pre-opened mocked link (bypassing connect)."""
+    stirrer = PawduinoStirrer(port="/dev/ttyACM0", **kwargs)
+    ser = MagicMock()
+    ser.is_open = True
+    ser.in_waiting = 0
+    ser.readline.side_effect = [r.encode() + b"\n" for r in responses]
+    link = PawduinoLink.acquire("/dev/ttyACM0")
+    link._serial = ser
+    link._holders = 1
+    stirrer._link = link
+    return stirrer, ser
+
+
+def _sent(ser):
+    return [c.args[0].decode().strip() for c in ser.write.call_args_list]
+
+
+class FakeGantry:
+    def __init__(self, instruments):
+        self.instruments = instruments
+        self.safe_z = 100.0
+
+
+def _context(instruments):
+    return ProtocolContext(gantry=FakeGantry(instruments), deck=None)
+
+
+class TestRegistry:
+    def test_stirrer_is_deck_mounted(self):
+        assert get_mount("stirrer") == "deck"
+        assert is_deck_mounted("stirrer")
+
+    def test_head_types_default_to_head(self):
+        assert get_mount("pipette") == "head"
+        assert not is_deck_mounted("capper")
+
+    def test_vendors_resolve(self):
+        assert get_instrument_class("stirrer", "pawduino") is PawduinoStirrer
+        assert get_instrument_class("stirrer", "mock") is MockStirrer
+        assert issubclass(PawduinoStirrer, StirrerInstrument)
+        assert issubclass(StirrerInstrument, BaseInstrument)
+
+
+class TestLoader:
+    def test_loader_marks_instance_deck_mounted(self):
+        instruments = _instantiate_instruments(
+            {
+                "stirrer_1": {"type": "stirrer", "vendor": "pawduino",
+                              "port": "/dev/ttyACM0", "offset_x": 0.0,
+                              "offset_y": 0.0, "depth": 0.0},
+                "cam": {"type": "camera", "vendor": "mount_only"},
+            },
+            mock_mode=True,
+        )
+        assert instruments["stirrer_1"].is_deck_mounted
+        assert not instruments["cam"].is_deck_mounted
+
+    @pytest.mark.parametrize("field", ["offset_x", "offset_y", "depth"])
+    def test_loader_rejects_head_geometry_on_deck_instrument(self, field):
+        with pytest.raises(ValueError, match="deck-mounted"):
+            _instantiate_instruments(
+                {"stirrer_1": {"type": "stirrer", "vendor": "mock", field: 5.0}},
+            )
+
+    def test_loader_rejects_unknown_fields(self):
+        with pytest.raises(ValueError, match="unsupported YAML"):
+            _instantiate_instruments(
+                {"stirrer_1": {"type": "stirrer", "vendor": "pawduino",
+                               "channel": 2}},
+            )
+
+
+class TestGantryHandling:
+    def test_head_cannot_move_to_deck_instrument(self):
+        gantry = InstrumentedGantry(
+            controller=None,
+            instruments={"stirrer_1": MockStirrer(), "cam": MountOnlyCamera(offline=True)},
+        )
+        with pytest.raises(ValueError, match="deck-mounted"):
+            gantry._resolve_instrument("stirrer_1")
+        assert list(gantry.head_instruments) == ["cam"]
+
+    def test_disconnect_stops_stirrers(self):
+        stirrer = MockStirrer()
+        stirrer.set_stirrer_params(600)
+        gantry = InstrumentedGantry(controller=None, instruments={"stirrer_1": stirrer})
+        gantry.disconnect_instruments()
+        assert stirrer.actuation_log[-1] == "set_stirrer_params 0"
+        assert not stirrer.get_stirrer_params().running
+
+    def test_disconnect_proceeds_when_stop_fails(self):
+        stirrer = MockStirrer()
+        disconnected = []
+
+        def failing_stop():
+            raise RuntimeError("dead board")
+
+        stirrer.stop = failing_stop
+        original = stirrer.disconnect
+        stirrer.disconnect = lambda: disconnected.append(True) or original()
+        gantry = InstrumentedGantry(controller=None, instruments={"stirrer_1": stirrer})
+        gantry.disconnect_instruments()
+        assert disconnected == [True]
+
+
+class TestPawduinoStirrer:
+    def test_set_stirrer_params_sends_30_with_seconds(self):
+        stirrer, ser = _linked_stirrer(['OK:{"msg":"Stirring","v":[600.00,90.00]}'])
+        assert stirrer.set_stirrer_params(600, 90) == 600.0
+        assert _sent(ser) == ["30,600.0,90.0"]
+
+    def test_set_stirrer_params_untimed(self):
+        stirrer, ser = _linked_stirrer(['OK:{"msg":"Stirring","v":[400.00,0.00]}'])
+        stirrer.set_stirrer_params(400)
+        assert _sent(ser) == ["30,400.0"]
+
+    def test_stop_sends_30_0_then_reads_status(self):
+        stirrer, ser = _linked_stirrer(['OK:{"msg":"Stirrer off"}', STATUS_STOPPED])
+        stirrer.stop()
+        assert _sent(ser) == ["30,0", "31"]
+
+    def test_get_stirrer_params_sends_31_and_parses(self):
+        stirrer, _ = _linked_stirrer([STATUS_RUNNING])
+        status = stirrer.get_stirrer_params()
+        assert status.target_rpm == 600 and status.rpm == 290.0
+        assert status.duty == pytest.approx(0.412)
+        assert status.seconds_left is None and not status.stalled
+        assert status.running
+
+    def test_set_stirrer_params_zero_sends_30_0_then_31(self):
+        stirrer, ser = _linked_stirrer(['OK:{"msg":"Stirrer off"}', STATUS_STOPPED])
+        assert stirrer.set_stirrer_params(0) == 0.0
+        assert _sent(ser) == ["30,0", "31"]
+
+    def test_zero_rpm_takes_no_seconds(self):
+        stirrer, ser = _linked_stirrer([])
+        with pytest.raises(StirrerConfigError, match="non-zero rpm"):
+            stirrer.set_stirrer_params(0, 30)
+        assert _sent(ser) == []
+
+    def test_timed_status_has_seconds_left(self):
+        s = parse_status('OK:{"target":600,"setpoint":600,"rpm":612.0,'
+                         '"duty":0.5,"stalled":0,"left_s":42}')
+        assert s.seconds_left == 42
+
+    @pytest.mark.parametrize("rpm", [50, 2500, -1])
+    def test_out_of_range_rpm_rejected_before_sending(self, rpm):
+        stirrer, ser = _linked_stirrer([])
+        with pytest.raises(StirrerConfigError):
+            stirrer.set_stirrer_params(rpm)
+        assert _sent(ser) == []
+
+    def test_seconds_must_be_positive(self):
+        stirrer, _ = _linked_stirrer([])
+        with pytest.raises(StirrerConfigError):
+            stirrer.set_stirrer_params(600, 0)
+
+    def test_connect_refuses_firmware_without_stir_commands(self, monkeypatch):
+        stirrer = PawduinoStirrer(port="/dev/ttyACM0")
+        link = PawduinoLink.acquire("/dev/ttyACM0")
+        monkeypatch.setattr(link, "connect", lambda timeout=30.0: None)
+        monkeypatch.setattr(link, "disconnect", lambda: None)
+
+        from cubos.instruments.controllers.pawduino import PawduinoLinkCommandError
+
+        def send(code, *args, timeout=30.0, expect=None):
+            raise PawduinoLinkCommandError(f"Command {code} failed: ERR:Unknown command")
+
+        monkeypatch.setattr(link, "send_command", send)
+        with pytest.raises(StirrerConnectionError, match="stirrer firmware"):
+            stirrer.connect()
+
+    def test_offline_simulates(self):
+        stirrer = PawduinoStirrer(offline=True)
+        stirrer.connect()
+        stirrer.set_stirrer_params(600, 30)
+        assert stirrer.get_stirrer_params().running
+        assert not stirrer.wait_until_stopped(40).running
+        stirrer.disconnect()
+
