 "title": "In a vertical lab, equipment is brought to the operator",
 "speed": 2.5,
 "camera": "c4",
 "phases": [
  {
   "start_frame": 0,
   "text": "The operator, here a mobile robot arm, takes a sample from an instrument outside the VLM."
  },
  {
   "start_frame": 85,
   "text": "It drives over. The VLM has already brought the tray it needs to the opening."
  },
  {
   "start_frame": 134,
   "text": "Tray A: the new sample goes in, and the one whose test is done comes out."
  },
  {
   "start_frame": 279,
   "text": "Tray A goes back into storage, still powered, and runs the test there. Tray B comes down."
  },
  {
   "start_frame": 425,
   "text": "Tray B: the tested sample goes into storage, and an empty vial comes out."
  },
  {
   "start_frame": 570,
   "text": "The arm takes the empty vial back to the instrument for its next sample."
  }
 ]
