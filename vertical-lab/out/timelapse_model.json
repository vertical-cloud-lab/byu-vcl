  },
  "charge_per_run": {
   "value": 300.0,
   "unit": "g",
   "source": "four cups as long as the Oct 27 rod pieces, about 300 g (notes/alloy_atomize.md, 'Four cups a run'); chapter 1's 2.5 in cups hold 157 g"
  },
  "usable_frac": {
   "value": 0.91,
   "source": "the Oct 27 bronze run: 91 % under 250 um (DAL #219, notes/alloy_atomize.md)"
  },
  "fines_frac": {
   "value": 0.17,
   "source": "the same run: 17 % of the charge under 63 um, the MIDI's cut (DAL #219); an upper estimate for Al, which atomizes coarser"
  },
  "run_fail_every": {
   "value": 10,
   "source": "assumed: one run in ten drips instead of atomizing, as the Oct 8 Al 6063 run did (notes/alloy_atomize.md)"
  },
  "screen_build_g": {
   "value": 30.0,
   "unit": "g",
   "source": "the MIDI's 55 mm reduction kit takes about 30 g (DAL #138, notes/alloy_print.md)"
  },
  "full_build_g": {
   "value": 440.0,
   "unit": "g",
   "source": "the full 170 mm cylinder, the lab's planning figure (powder-doser design/brainstorming.md section 3, notes/alloy_atomize.md)"
  },
  "build_fail_every": {
   "value": 7,
   "source": "assumed: one screening build in seven cracks or delaminates, and that alloy stops at its powder data"
  },
  "promote_every": {
   "value": 10,
   "source": "assumed: one fully tested alloy in ten is promoted to a full-plate build of chapter 5's E8 subsize bars"
  },
  "transfer_h": {
   "value": 0.1,
   "unit": "h",
   "source": "assumed: a unit's drive plus pick and place, about 6 min (the MiR250 at 0.3 m/s^2, props.ramp_secs; the arm's moves in chapters 1-7)"
  },
  "units": {
   "value": 2,
   "source": "two MiR250 + UR10e units (setup_lab.py)"
  },
  "stream_mbps": {
   "value": 1.0,
   "unit": "Mbit/s per camera",
   "source": "assumed: each stream camera archived at 1 Mbit/s, 24 h a day"
