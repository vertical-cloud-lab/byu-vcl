 "clip": {
  "name": "vacuum_press",
  "fps": 15,
  "n_frames": 756,
  "size": [
   1280,
   720
  ],
  "substeps": [
   {
    "label": "1/9",
    "caption": "A Specac Atlas Autotouch 15T: an automatic hydraulic press, 425 x 405 x 640 mm. Our evacuable die, built round #222's steel sleeve F1, rides on a shuttle in front of it. A pump, two valves and a gauge make the vacuum.",
    "start_frame": 0,
    "end_frame": 75
   },
   {
    "label": "2/9",
    "caption": "The guard slides up. The shuttle brings the die out of the press, to the arm.",
    "start_frame": 76,
    "end_frame": 98
   },
   {
    "label": "2/9",
    "caption": "The guard slides up. The shuttle brings the die out of the press, to the arm.",
    "start_frame": 99,
    "end_frame": 126
   },
   {
    "label": "3/9",
    "caption": "Cut open. The ejector raises its pin. The arm sets a dosed cup in the die's mouth, on the pin: a catch ring on F1 holds its bottom 10 mm, so it stands in a socket, not on a bare pin. 9.61 g of AlSi10Mg, tapped up to where the plug will stand. The pin lowers the cup into F1.",
    "start_frame": 127,
    "end_frame": 146
   },
   {
    "label": "3/9",
    "caption": "Cut open. The ejector raises its pin. The arm sets a dosed cup in the die's mouth, on the pin: a catch ring on F1 holds its bottom 10 mm, so it stands in a socket, not on a bare pin. 9.61 g of AlSi10Mg, tapped up to where the plug will stand. The pin lowers the cup into F1.",
    "start_frame": 147,
    "end_frame": 179
   },
   {
    "label": "3/9",
    "caption": "Cut open. The ejector raises its pin. The arm sets a dosed cup in the die's mouth, on the pin: a catch ring on F1 holds its bottom 10 mm, so it stands in a socket, not on a bare pin. 9.61 g of AlSi10Mg, tapped up to where the plug will stand. The pin lowers the cup into F1.",
    "start_frame": 180,
    "end_frame": 205
   },
   {
    "label": "4/9",
    "caption": "The arm sets the plug in the mouth, on its lead-in, 8.0 mm proud. Then the punch: the O-ring on its nose seals in the catch ring, and the channel across the plug's top (DAL #156) keeps the vent open under it.",
    "start_frame": 206,
    "end_frame": 228
   },
   {
    "label": "4/9",
    "caption": "The arm sets the plug in the mouth, on its lead-in, 8.0 mm proud. Then the punch: the O-ring on its nose seals in the catch ring, and the channel across the plug's top (DAL #156) keeps the vent open under it.",
    "start_frame": 229,
    "end_frame": 261
   },
   {
    "label": "5/9",
    "caption": "The shuttle slides in under the leadscrew. The guard closes: the press will not start with it open.",
    "start_frame": 262,
    "end_frame": 287
   },
   {
    "label": "5/9",
    "caption": "The shuttle slides in under the leadscrew. The guard closes: the press will not start with it open.",
    "start_frame": 288,
    "end_frame": 309
   },
   {
    "label": "6/9",
    "caption": "V1 opens to the pump, slowly at first through the needle valve, so the powder stays put. Air leaves the cup through the vent and out of the port. Hold 2 min under 1 mbar.",
    "start_frame": 310,
    "end_frame": 383
   },
   {
    "label": "7/9",
    "caption": "Start: program P1 pumps up to 3.2 t. The ram lifts the die 2 mm to the leadscrew, then drives the plug 8.0 mm to flush. The powder goes from 60 to 72 % dense.",
    "start_frame": 384,
    "end_frame": 469
   },
   {
    "label": "7/9",
    "caption": "It holds 3.2 t for a minute, topping up as the powder settles. At flush the punch's collar lands on the catch ring, so F1 under it takes the load past flush: 1.1 t is on the powder.",
    "start_frame": 470,
    "end_frame": 517
   },
   {
    "label": "8/9",
