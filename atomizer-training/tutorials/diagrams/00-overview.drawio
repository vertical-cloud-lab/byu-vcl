        <mxCell id="s2_lane" value="Tutorial 2 · During a run" style="swimlane;startSize=38;horizontal=1;rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontSize=22;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=14;fillColor=#C2410C;swimlaneFillColor=#FCEDE4;strokeColor=#C2410C;strokeWidth=2;collapsible=0;swimlaneLine=0;" vertex="1" parent="1">
