        <mxCell id="s2_c1" value="furnace ×5, then chamber&lt;br&gt;again at &lt;b style=&quot;white-space:nowrap&quot;&gt;250 °C&lt;/b&gt; and &lt;b style=&quot;white-space:nowrap&quot;&gt;500 °C&lt;/b&gt;&lt;br&gt;O₂ &lt;b style=&quot;white-space:nowrap&quot;&gt;≤ 100 ppm&lt;/b&gt;, best &lt;b style=&quot;white-space:nowrap&quot;&gt;40–50&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=20;fontColor=#1F2937;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="s2_lane">
