        <mxCell id="s1_b1" value="1 · Utilities on" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=24;fontStyle=1;fillColor=#FFFFFF;strokeColor=#00897B;strokeWidth=3;fontColor=#1F2937;" vertex="1" parent="s1_lane">
