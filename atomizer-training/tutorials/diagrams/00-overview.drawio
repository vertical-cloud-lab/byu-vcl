          <mxGeometry x="328" y="50" width="266" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s2_c2" value="overshoot to drop the charge&lt;br&gt;then &lt;b style=&quot;white-space:nowrap&quot;&gt;780–800 °C&lt;/b&gt;&lt;br&gt;hold &lt;b style=&quot;white-space:nowrap&quot;&gt;2 min&lt;/b&gt;, no longer" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=20;fontColor=#1F2937;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="s2_lane">
