        <mxCell id="bg" value="" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="bg_layer">
          <mxGeometry x="0" y="0" width="1280" height="720" as="geometry" />
        </mxCell>
        <mxCell id="1" value="Outline" parent="0" />
        <mxCell id="title" value="Tutorial 3 · After a run" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=42;fontStyle=1;fontColor=#1F2937;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="22" width="1200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s1_box" value="&lt;span style=&quot;font-size:20px;font-weight:normal&quot;&gt;Step 1&lt;/span&gt;&lt;br&gt;Shutdown sequence" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=25;fontStyle=1;fillColor=#6D28D9;strokeColor=#4C1D95;strokeWidth=2;fontColor=#FFFFFF;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="30" y="132.6" width="276.5" height="104" as="geometry" />
        </mxCell>
        <mxCell id="s1_panel" value="&lt;ul style=&quot;margin:0;padding-left:22px&quot;&gt;&lt;li style=&quot;margin-bottom:12px&quot;&gt;rod down, &lt;span style=&quot;white-space:nowrap&quot;&gt;melting pressure&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;margin-bottom:12px&quot;&gt;generator and ultrasonics stopped&lt;/li&gt;&lt;li style=&quot;margin-bottom:12px&quot;&gt;setpoint &lt;b style=&quot;white-space:nowrap&quot;&gt;&lt;span style=&quot;white-space:nowrap&quot;&gt;250 °C&lt;/span&gt;&lt;/b&gt; for &lt;span style=&quot;white-space:nowrap&quot;&gt;next time&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;margin-bottom:12px&quot;&gt;transducer cooling off&lt;/li&gt;&lt;li style=&quot;margin-bottom:0px&quot;&gt;run log written &lt;span style=&quot;white-space:nowrap&quot;&gt;while fresh&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fontSize=22;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=14;fillColor=#EFE9FC;strokeColor=#6D28D9;strokeWidth=1;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="30" y="252.6" width="276.5" height="416.8" as="geometry" />
        </mxCell>
        <mxCell id="s2_box" value="&lt;span style=&quot;font-size:20px;font-weight:normal&quot;&gt;Step 2&lt;/span&gt;&lt;br&gt;Cool down &amp;amp; open" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=25;fontStyle=1;fillColor=#6D28D9;strokeColor=#4C1D95;strokeWidth=2;fontColor=#FFFFFF;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="344.5" y="132.6" width="276.5" height="104" as="geometry" />
        </mxCell>
        <mxCell id="s2_panel" value="&lt;ul style=&quot;margin:0;padding-left:22px&quot;&gt;&lt;li style=&quot;margin-bottom:12px&quot;&gt;furnace &lt;b style=&quot;white-space:nowrap&quot;&gt;&lt;span style=&quot;white-space:nowrap&quot;&gt;≤ 400 °C&lt;/span&gt;&lt;/b&gt;&lt;/li&gt;&lt;li style=&quot;margin-bottom:12px&quot;&gt;pressure control off, &lt;span style=&quot;white-space:nowrap&quot;&gt;vent first&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;margin-bottom:12px&quot;&gt;respirator, gloves, coat; &lt;span style=&quot;white-space:nowrap&quot;&gt;then the &lt;/span&gt;&lt;b style=&quot;white-space:nowrap&quot;&gt;&lt;span style=&quot;white-space:nowrap&quot;&gt;3&lt;/span&gt;&lt;/b&gt;&lt;span style=&quot;white-space:nowrap&quot;&gt; clamps&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;margin-bottom:0px&quot;&gt;utilities off at &lt;b style=&quot;white-space:nowrap&quot;&gt;&lt;span style=&quot;white-space:nowrap&quot;&gt;~100 °C&lt;/span&gt;&lt;/b&gt;&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fontSize=22;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=14;fillColor=#EFE9FC;strokeColor=#6D28D9;strokeWidth=1;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="344.5" y="252.6" width="276.5" height="416.8" as="geometry" />
        </mxCell>
        <mxCell id="s3_box" value="&lt;span style=&quot;font-size:20px;font-weight:normal&quot;&gt;Step 3&lt;/span&gt;&lt;br&gt;Collect powder" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=25;fontStyle=1;fillColor=#6D28D9;strokeColor=#4C1D95;strokeWidth=2;fontColor=#FFFFFF;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="659" y="132.6" width="276.5" height="104" as="geometry" />
        </mxCell>
        <mxCell id="s3_panel" value="&lt;ul style=&quot;margin:0;padding-left:22px&quot;&gt;&lt;li style=&quot;margin-bottom:12px&quot;&gt;brush powder into &lt;span style=&quot;white-space:nowrap&quot;&gt;the container&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;margin-bottom:12px&quot;&gt;close the container valve, remove it&lt;/li&gt;&lt;li style=&quot;margin-bottom:12px&quot;&gt;pour onto paper, &lt;span style=&quot;white-space:nowrap&quot;&gt;pick out chunks&lt;/span&gt;, sieve&lt;/li&gt;&lt;li style=&quot;margin-bottom:0px&quot;&gt;bag, &lt;b style=&quot;white-space:nowrap&quot;&gt;&lt;span style=&quot;white-space:nowrap&quot;&gt;6-character&lt;/span&gt;&lt;/b&gt; ID label, photo&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fontSize=22;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=14;fillColor=#EFE9FC;strokeColor=#6D28D9;strokeWidth=1;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="659" y="252.6" width="276.5" height="416.8" as="geometry" />
        </mxCell>
        <mxCell id="s4_box" value="&lt;span style=&quot;font-size:20px;font-weight:normal&quot;&gt;Step 4&lt;/span&gt;&lt;br&gt;Clean &amp;amp; maintain" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=25;fontStyle=1;fillColor=#6D28D9;strokeColor=#4C1D95;strokeWidth=2;fontColor=#FFFFFF;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="973.5" y="132.6" width="276.5" height="104" as="geometry" />
        </mxCell>
        <mxCell id="s4_panel" value="&lt;ul style=&quot;margin:0;padding-left:22px&quot;&gt;&lt;li style=&quot;margin-bottom:12px&quot;&gt;same alloy next: brush, light clean&lt;/li&gt;&lt;li style=&quot;margin-bottom:12px&quot;&gt;alloy change: vacuum, wipe all, &lt;b style=&quot;white-space:nowrap&quot;&gt;&lt;span style=&quot;white-space:nowrap&quot;&gt;~1 h&lt;/span&gt;&lt;/b&gt;&lt;/li&gt;&lt;li style=&quot;margin-bottom:12px&quot;&gt;plates: one alloy &lt;span style=&quot;white-space:nowrap&quot;&gt;each, logged&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;margin-bottom:12px&quot;&gt;slag and nozzle checked once cool&lt;/li&gt;&lt;li style=&quot;margin-bottom:0px&quot;&gt;HEPA filter every &lt;b style=&quot;white-space:nowrap&quot;&gt;&lt;span style=&quot;white-space:nowrap&quot;&gt;~2 months&lt;/span&gt;&lt;/b&gt;&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fontSize=22;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=14;fillColor=#EFE9FC;strokeColor=#6D28D9;strokeWidth=1;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="973.5" y="252.6" width="276.5" height="416.8" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;endSize=5;strokeWidth=4;strokeColor=#4B5563;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s1_box" target="s2_box">
