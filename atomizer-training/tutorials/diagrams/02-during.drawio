<mxfile host="make_diagrams.py" type="device">
  <diagram id="Tutorial2Duringarun" name="Tutorial 2 · During a run">
    <mxGraphModel dx="1280" dy="720" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="720" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="bg_layer" value="Background (locked)" style="locked=1;" parent="0" />
        <mxCell id="bg" value="" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="bg_layer">
          <mxGeometry x="0" y="0" width="1280" height="720" as="geometry" />
        </mxCell>
        <mxCell id="1" value="Outline" parent="0" />
        <mxCell id="title" value="Tutorial 2 · During a run" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=42;fontStyle=1;fontColor=#1F2937;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="22" width="1200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s1_box" value="&lt;span style=&quot;font-size:20px;font-weight:normal&quot;&gt;Step 1&lt;/span&gt;&lt;br&gt;Gas wash" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=28;fontStyle=1;fillColor=#C2410C;strokeColor=#7C2D12;strokeWidth=2;fontColor=#FFFFFF;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="30" y="132.6" width="276.5" height="104" as="geometry" />
        </mxCell>
        <mxCell id="s1_panel" value="&lt;ul style=&quot;margin:0;padding-left:22px&quot;&gt;&lt;li style=&quot;margin-bottom:12px&quot;&gt;pressure control off before pumping&lt;/li&gt;&lt;li style=&quot;margin-bottom:12px&quot;&gt;furnace &lt;b style=&quot;white-space:nowrap&quot;&gt;&lt;span style=&quot;white-space:nowrap&quot;&gt;×5&lt;/span&gt;&lt;/b&gt; cycles, &lt;span style=&quot;white-space:nowrap&quot;&gt;then chamber&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;margin-bottom:12px&quot;&gt;again at &lt;b style=&quot;white-space:nowrap&quot;&gt;&lt;span style=&quot;white-space:nowrap&quot;&gt;250 °C&lt;/span&gt;&lt;/b&gt; &lt;span style=&quot;white-space:nowrap&quot;&gt;and &lt;/span&gt;&lt;b style=&quot;white-space:nowrap&quot;&gt;&lt;span style=&quot;white-space:nowrap&quot;&gt;500 °C&lt;/span&gt;&lt;/b&gt;&lt;/li&gt;&lt;li style=&quot;margin-bottom:0px&quot;&gt;O₂ read under gas: &lt;b style=&quot;white-space:nowrap&quot;&gt;&lt;span style=&quot;white-space:nowrap&quot;&gt;≤ 100 ppm&lt;/span&gt;&lt;/b&gt;, best &lt;b style=&quot;white-space:nowrap&quot;&gt;&lt;span style=&quot;white-space:nowrap&quot;&gt;40–50&lt;/span&gt;&lt;/b&gt;&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fontSize=22;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=14;fillColor=#FCEDE4;strokeColor=#C2410C;strokeWidth=1;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="30" y="252.6" width="276.5" height="416.8" as="geometry" />
        </mxCell>
        <mxCell id="s2_box" value="&lt;span style=&quot;font-size:20px;font-weight:normal&quot;&gt;Step 2&lt;/span&gt;&lt;br&gt;Heat &amp;amp; melt" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=28;fontStyle=1;fillColor=#C2410C;strokeColor=#7C2D12;strokeWidth=2;fontColor=#FFFFFF;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="344.5" y="132.6" width="276.5" height="104" as="geometry" />
        </mxCell>
        <mxCell id="s2_panel" value="&lt;ul style=&quot;margin:0;padding-left:22px&quot;&gt;&lt;li style=&quot;margin-bottom:12px&quot;&gt;melting pressure, pressure control on&lt;/li&gt;&lt;li style=&quot;margin-bottom:12px&quot;&gt;setpoint &lt;b style=&quot;white-space:nowrap&quot;&gt;&lt;span style=&quot;white-space:nowrap&quot;&gt;850–1000 °C&lt;/span&gt;&lt;/b&gt; drops the charge&lt;/li&gt;&lt;li style=&quot;margin-bottom:12px&quot;&gt;at the melting cues: &lt;b style=&quot;white-space:nowrap&quot;&gt;&lt;span style=&quot;white-space:nowrap&quot;&gt;780–800 °C&lt;/span&gt;&lt;/b&gt;&lt;/li&gt;&lt;li style=&quot;margin-bottom:0px&quot;&gt;wait &lt;b style=&quot;white-space:nowrap&quot;&gt;&lt;span style=&quot;white-space:nowrap&quot;&gt;2 min&lt;/span&gt;&lt;/b&gt;, no longer&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fontSize=22;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=14;fillColor=#FCEDE4;strokeColor=#C2410C;strokeWidth=1;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="344.5" y="252.6" width="276.5" height="416.8" as="geometry" />
        </mxCell>
        <mxCell id="s3_box" value="&lt;span style=&quot;font-size:20px;font-weight:normal&quot;&gt;Step 3&lt;/span&gt;&lt;br&gt;Pour" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=28;fontStyle=1;fillColor=#C2410C;strokeColor=#7C2D12;strokeWidth=2;fontColor=#FFFFFF;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="659" y="132.6" width="276.5" height="104" as="geometry" />
        </mxCell>
        <mxCell id="s3_panel" value="&lt;ul style=&quot;margin:0;padding-left:22px&quot;&gt;&lt;li style=&quot;margin-bottom:12px&quot;&gt;transducer cooling on, rescan&lt;/li&gt;&lt;li style=&quot;margin-bottom:12px&quot;&gt;amplitude &lt;b style=&quot;white-space:nowrap&quot;&gt;&lt;span style=&quot;white-space:nowrap&quot;&gt;~90&lt;/span&gt;&lt;/b&gt;&lt;/li&gt;&lt;li style=&quot;margin-bottom:12px&quot;&gt;vibration on&lt;br&gt;→ draining pressure&lt;br&gt;→ sealing rod up&lt;br&gt;→ turbo as needed&lt;/li&gt;&lt;li style=&quot;margin-bottom:0px&quot;&gt;operator at the window, &lt;b style=&quot;white-space:nowrap&quot;&gt;&lt;span style=&quot;white-space:nowrap&quot;&gt;2–3 min&lt;/span&gt;&lt;/b&gt;&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fontSize=22;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=14;fillColor=#FCEDE4;strokeColor=#C2410C;strokeWidth=1;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="659" y="252.6" width="276.5" height="416.8" as="geometry" />
        </mxCell>
        <mxCell id="s4_box" value="&lt;span style=&quot;font-size:20px;font-weight:normal&quot;&gt;Step 4&lt;/span&gt;&lt;br&gt;End of pour" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=28;fontStyle=1;fillColor=#C2410C;strokeColor=#7C2D12;strokeWidth=2;fontColor=#FFFFFF;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="973.5" y="132.6" width="276.5" height="104" as="geometry" />
        </mxCell>
        <mxCell id="s4_panel" value="&lt;ul style=&quot;margin:0;padding-left:22px&quot;&gt;&lt;li style=&quot;margin-bottom:12px&quot;&gt;turbo to clear &lt;span style=&quot;white-space:nowrap&quot;&gt;the nozzle&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;margin-bottom:12px&quot;&gt;sealing rod down&lt;/li&gt;&lt;li style=&quot;margin-bottom:12px&quot;&gt;melting pressure&lt;/li&gt;&lt;li style=&quot;margin-bottom:12px&quot;&gt;generator stop&lt;/li&gt;&lt;li style=&quot;margin-bottom:12px&quot;&gt;ultrasonics stop&lt;/li&gt;&lt;li style=&quot;margin-bottom:0px&quot;&gt;all &lt;b style=&quot;white-space:nowrap&quot;&gt;&lt;span style=&quot;white-space:nowrap&quot;&gt;within seconds&lt;/span&gt;&lt;/b&gt;&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fontSize=22;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=14;fillColor=#FCEDE4;strokeColor=#C2410C;strokeWidth=1;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="973.5" y="252.6" width="276.5" height="416.8" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;endSize=5;strokeWidth=4;strokeColor=#4B5563;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s1_box" target="s2_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;endSize=5;strokeWidth=4;strokeColor=#4B5563;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s2_box" target="s3_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;endSize=5;strokeWidth=4;strokeColor=#4B5563;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3_box" target="s4_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
