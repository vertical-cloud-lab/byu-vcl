          <mxGeometry x="40" y="22" width="1200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s1_box" value="&lt;span style=&quot;font-size:20px;font-weight:normal&quot;&gt;Step 1&lt;/span&gt;&lt;br&gt;Utilities" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=28;fontStyle=1;fillColor=#00897B;strokeColor=#00574B;strokeWidth=2;fontColor=#FFFFFF;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="30" y="132.6" width="276.5" height="104" as="geometry" />
        </mxCell>
        <mxCell id="s1_panel" value="&lt;ul style=&quot;margin:0;padding-left:22px&quot;&gt;&lt;li style=&quot;margin-bottom:12px&quot;&gt;chilled water: facility valve &lt;span style=&quot;white-space:nowrap&quot;&gt;barely open&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;margin-bottom:12px&quot;&gt;compressed air &lt;b style=&quot;white-space:nowrap&quot;&gt;&lt;span style=&quot;white-space:nowrap&quot;&gt;~4 bar&lt;/span&gt;&lt;/b&gt; (&lt;b style=&quot;white-space:nowrap&quot;&gt;&lt;span style=&quot;white-space:nowrap&quot;&gt;8 bar&lt;/span&gt;&lt;/b&gt; supply)&lt;/li&gt;&lt;li style=&quot;margin-bottom:12px&quot;&gt;argon 5N, &lt;span style=&quot;white-space:nowrap&quot;&gt;regulator at &lt;/span&gt;&lt;b style=&quot;white-space:nowrap&quot;&gt;&lt;span style=&quot;white-space:nowrap&quot;&gt;8 bar&lt;/span&gt;&lt;/b&gt;&lt;/li&gt;&lt;li style=&quot;margin-bottom:0px&quot;&gt;vacuum pump oil between min and max&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fontSize=22;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=14;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=1;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="30" y="252.6" width="276.5" height="416.8" as="geometry" />
        </mxCell>
        <mxCell id="s2_box" value="&lt;span style=&quot;font-size:20px;font-weight:normal&quot;&gt;Step 2&lt;/span&gt;&lt;br&gt;Ultrasonic stack" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=28;fontStyle=1;fillColor=#00897B;strokeColor=#00574B;strokeWidth=2;fontColor=#FFFFFF;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="344.5" y="132.6" width="276.5" height="104" as="geometry" />
        </mxCell>
        <mxCell id="s2_panel" value="&lt;ul style=&quot;margin:0;padding-left:22px&quot;&gt;&lt;li style=&quot;margin-bottom:12px&quot;&gt;transducer → booster → sonotrode → plate&lt;/li&gt;&lt;li style=&quot;margin-bottom:12px&quot;&gt;torque &lt;b style=&quot;white-space:nowrap&quot;&gt;&lt;span style=&quot;white-space:nowrap&quot;&gt;65 / 60 / 50 N·m&lt;/span&gt;&lt;/b&gt;&lt;/li&gt;&lt;li style=&quot;margin-bottom:12px&quot;&gt;scan: one wide peak, &lt;span style=&quot;white-space:nowrap&quot;&gt;a little over &lt;/span&gt;&lt;b style=&quot;white-space:nowrap&quot;&gt;&lt;span style=&quot;white-space:nowrap&quot;&gt;40 kHz&lt;/span&gt;&lt;/b&gt;&lt;/li&gt;&lt;li style=&quot;margin-bottom:12px&quot;&gt;wet test: the whole plate atomizes&lt;/li&gt;&lt;li style=&quot;margin-bottom:0px&quot;&gt;transducer cover on&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fontSize=22;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=14;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=1;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="344.5" y="252.6" width="276.5" height="416.8" as="geometry" />
        </mxCell>
        <mxCell id="s3_box" value="&lt;span style=&quot;font-size:20px;font-weight:normal&quot;&gt;Step 3&lt;/span&gt;&lt;br&gt;Furnace" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=28;fontStyle=1;fillColor=#00897B;strokeColor=#00574B;strokeWidth=2;fontColor=#FFFFFF;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="659" y="132.6" width="276.5" height="104" as="geometry" />
        </mxCell>
        <mxCell id="s3_panel" value="&lt;ul style=&quot;margin:0;padding-left:22px&quot;&gt;&lt;li style=&quot;margin-bottom:12px&quot;&gt;nozzle &lt;b style=&quot;white-space:nowrap&quot;&gt;&lt;span style=&quot;white-space:nowrap&quot;&gt;0.5 / 0.7 mm&lt;/span&gt;&lt;/b&gt;, white side up&lt;/li&gt;&lt;li style=&quot;margin-bottom:12px&quot;&gt;crucible threaded &lt;span style=&quot;white-space:nowrap&quot;&gt;just tight&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;margin-bottom:12px&quot;&gt;insulation, then thermocouple&lt;/li&gt;&lt;li style=&quot;margin-bottom:12px&quot;&gt;sealing rod: clean, undamaged tip; &lt;span style=&quot;white-space:nowrap&quot;&gt;lowered before loading&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;margin-bottom:12px&quot;&gt;clean charge &lt;b style=&quot;white-space:nowrap&quot;&gt;&lt;span style=&quot;white-space:nowrap&quot;&gt;≤ 20 mm&lt;/span&gt;&lt;/b&gt; diameter, &lt;b style=&quot;white-space:nowrap&quot;&gt;&lt;span style=&quot;white-space:nowrap&quot;&gt;250–300 g&lt;/span&gt;&lt;/b&gt;&lt;/li&gt;&lt;li style=&quot;margin-bottom:0px&quot;&gt;lid latched, no hissing&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fontSize=22;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=14;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=1;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="659" y="252.6" width="276.5" height="416.8" as="geometry" />
        </mxCell>
        <mxCell id="s4_box" value="&lt;span style=&quot;font-size:20px;font-weight:normal&quot;&gt;Step 4&lt;/span&gt;&lt;br&gt;Chamber" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=28;fontStyle=1;fillColor=#00897B;strokeColor=#00574B;strokeWidth=2;fontColor=#FFFFFF;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="973.5" y="132.6" width="276.5" height="104" as="geometry" />
        </mxCell>
        <mxCell id="s4_panel" value="&lt;ul style=&quot;margin:0;padding-left:22px&quot;&gt;&lt;li style=&quot;margin-bottom:12px&quot;&gt;container: flange &lt;span style=&quot;white-space:nowrap&quot;&gt;finger-tight&lt;/span&gt; &lt;span style=&quot;white-space:nowrap&quot;&gt;(a 2nd person helps)&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;margin-bottom:12px&quot;&gt;splash plate and &lt;span style=&quot;white-space:nowrap&quot;&gt;catch bowl in&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;margin-bottom:12px&quot;&gt;covers over &lt;span style=&quot;white-space:nowrap&quot;&gt;the openings&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;margin-bottom:0px&quot;&gt;chamber closed with &lt;span style=&quot;white-space:nowrap&quot;&gt;all &lt;/span&gt;&lt;b style=&quot;white-space:nowrap&quot;&gt;&lt;span style=&quot;white-space:nowrap&quot;&gt;3&lt;/span&gt;&lt;/b&gt;&lt;span style=&quot;white-space:nowrap&quot;&gt; clamps&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fontSize=22;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=14;fillColor=#E0F2F1;strokeColor=#00897B;strokeWidth=1;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="973.5" y="252.6" width="276.5" height="416.8" as="geometry" />
