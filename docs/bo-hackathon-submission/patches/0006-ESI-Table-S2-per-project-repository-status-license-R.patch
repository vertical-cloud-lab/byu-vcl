+#!/usr/bin/env python3
+"""Per-project repository status for ESI Table S2.
+
+Referee 1 asked for code availability, licensing, documentation, dependency
+status and maintenance per project.  For the repository each project links
+from Table III (project page first, registration spreadsheet otherwise, as in
+python_scripts/process_spreadsheet.py), this records whether it is reachable,
+its license, whether it has a README, which standard dependency files sit at
+its root, and when it was last pushed to.  Read-only GitHub REST calls via the
+``gh`` CLI.
+
+Usage:
+    python scripts/repo_status.py            # query GitHub, write JSON + table
+    python scripts/repo_status.py --table    # rebuild the table from the JSON
+
+Outputs: outputs/repo_status.json and latex/esi_repo_status_table.tex.
+"""
+import datetime as dt
+import json
+import re
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+JSON_OUT = ROOT / "outputs" / "repo_status.json"
+TEX_OUT = ROOT / "latex" / "esi_repo_status_table.tex"
+DEP_RE = re.compile(
+    r"(?i)^(requirements.*\.txt|environment.*\.ya?ml|pyproject\.toml|setup\.py|setup\.cfg|"
+    r"pipfile(\.lock)?|poetry\.lock|uv\.lock|renv\.lock|project\.toml|description|package\.json)$"
+)
+
+
+def gh(path):
+    r = subprocess.run(["gh", "api", path], capture_output=True, text=True)
+    return (json.loads(r.stdout), None) if r.returncode == 0 else (None, r.stderr.strip()[:120])
+
+
+def project_repos():
+    out = subprocess.run(["python3", str(ROOT / "python_scripts" / "process_spreadsheet.py")],
+                         capture_output=True, text=True, check=True).stdout
+    repos = {}
+    for line in out.splitlines():
+        m = re.match(r"(\d+) & .*? & (.*)\\\\$", line.strip())
+        if m:
+            g = re.search(r"\\href\{https://github\.com/([\w.-]+/[\w.-]+?)(?:\.git)?/?\}\{\\faGithub\}", m.group(2))
+            repos[int(m.group(1))] = g.group(1) if g else None
+    return repos
+
+
+def collect():
+    rows = []
+    for n, slug in sorted(project_repos().items()):
+        rec = {"project": n, "repo": slug}
+        if not slug:
+            rec["status"] = "no repository"
+        else:
+            meta, err = gh(f"repos/{slug}")
+            if meta is None:
+                rec.update(status="inaccessible", error=err)
+            else:
+                root, _ = gh(f"repos/{slug}/contents/")
+                names = [x["name"] for x in root] if isinstance(root, list) else []
+                rec.update(
+                    status="public",
+                    license=(meta.get("license") or {}).get("spdx_id") or "none",
+                    readme=gh(f"repos/{slug}/readme")[0] is not None,
+                    dependency_files=sorted(x for x in names if DEP_RE.match(x)),
+                    pushed_at=meta.get("pushed_at"),
+                    archived=meta.get("archived"),
+                )
+                time.sleep(0.2)
+        rows.append(rec)
+    data = {"checked": dt.date.today().isoformat(), "projects": rows}
+    JSON_OUT.parent.mkdir(exist_ok=True)
+    JSON_OUT.write_text(json.dumps(data, indent=1) + "\n")
+    return data
+
+
+def tex_escape(s):
+    return s.replace("_", r"\_").replace("&", r"\&")
+
+
+def table(data):
+    lic = {"none": "none", "NOASSERTION": "CC0-1.0"}
+    lines = []
+    for r in data["projects"]:
+        if r["status"] == "public":
+            deps = ", ".join(tex_escape(x) for x in r["dependency_files"]) or "none"
+            lines.append(
+                f"{r['project']} & \\path{{{r['repo']}}} & {lic.get(r['license'], r['license'])} & "
+                f"{'yes' if r['readme'] else 'no'} & {deps} & {r['pushed_at'][:7]} \\\\"
+            )
+        elif r["status"] == "inaccessible":
+            lines.append(f"{r['project']} & \\path{{{r['repo']}}} & \\multicolumn{{4}}{{l}}{{private or removed when checked}} \\\\")
+        else:
+            lines.append(f"{r['project']} & no repository (proposal stage) & \\multicolumn{{4}}{{l}}{{}} \\\\")
+    TEX_OUT.write_text("\n".join(lines) + "\n")
+
+
+if __name__ == "__main__":
+    data = json.loads(JSON_OUT.read_text()) if "--table" in sys.argv else collect()
+    table(data)
+    pub = [r for r in data["projects"] if r["status"] == "public"]
+    print(f"checked {data['checked']}: {len(pub)} public, "
+          f"{sum(r['status'] == 'inaccessible' for r in data['projects'])} inaccessible, "
+          f"{sum(r['status'] == 'no repository' for r in data['projects'])} without a repository; "
+          f"README {sum(r['readme'] for r in pub)}, dependency file {sum(bool(r['dependency_files']) for r in pub)}, "
+          f"pushed since 2025 {sum(r['pushed_at'] >= '2025-01-01' for r in pub)}")
