+#!/usr/bin/env python3
+"""ESI Table S3: the full URL behind every link icon in Table III.
+
+Referee 4 (minor comment 11) asked for links a reader of a printed copy can
+see. This prints the GitHub, video and social-media URL of each project,
+exactly as python_scripts/process_spreadsheet.py resolves them for Table III,
+as rows for latex/esi_links_table.tex.
+"""
+import re
+import subprocess
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+out = subprocess.run(["python3", str(ROOT / "python_scripts" / "process_spreadsheet.py")],
+                     capture_output=True, text=True, check=True).stdout
+rows = []
+for line in out.splitlines():
+    m = re.match(r"(\d+) & .*? & (.*)\\\\$", line.strip())
+    if not m:
+        continue
+    labels = {"faGithub": "GitHub", "faVideo": "Video", "faLinkedin": "LinkedIn", "faTwitter": "X/Twitter"}
+    links = re.findall(r"\\href\{([^}]*)\}\{\\(fa\w+)\}", m.group(2))
+    cell = " \\newline ".join(f"{labels.get(icon, icon)}: \\url{{{url}}}" for url, icon in links) or "none"
+    rows.append(f"{m.group(1)} & {cell} \\\\")
+(ROOT / "latex" / "esi_links_table.tex").write_text("\n".join(rows) + "\n", encoding="utf-8")
+print(f"{len(rows)} projects")
